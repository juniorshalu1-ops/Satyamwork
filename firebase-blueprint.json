  "firestore": {
    "/notices/{noticeId}": { "schema": { "$ref": "#/entities/Notice" }, "description": "Publicly readable notices; admin-only writes" },
    "/holiday_calendars/{calId}": { "schema": { "$ref": "#/entities/HolidayCalendar" }, "description": "Publicly readable holiday list; admin-only writes" },
    "/activities/{activityId}": { "schema": { "$ref": "#/entities/EducationActivity" }, "description": "Publicly readable activities; admin-only writes" },
    "/quick_portals/{portalId}": { "schema": { "$ref": "#/entities/QuickPortal" }, "description": "Publicly readable portal links; admin-only writes" },
    "/admin_broadcasts/{broadcastId}": { "schema": { "$ref": "#/entities/AdminBroadcast" }, "description": "Latest alert & 10-slot circular history; admin-only writes" },
    "/app_meta/{metaId}": { "schema": { "$ref": "#/entities/SyncVersionsMeta" }, "description": "Version gatekeeper metadata; admin-only writes" },
    "/school_config/{docId}": { "schema": { "$ref": "#/entities/SchoolTimingConfig" }, "description": "School timing configuration; admin-only writes" },
    "/whatsapp_config/{docId}": { "schema": { "$ref": "#/entities/WhatsAppConfig" }, "description": "WhatsApp links config; admin-only writes" },
    "/app_configs/{docId}": { "schema": { "$ref": "#/entities/GoogleDriveConfig" }, "description": "Google Drive ON/OFF configuration; admin-only writes" },
    "/app_config/{docId}": { "schema": { "$ref": "#/entities/AppConfigCard" }, "description": "Top three links, financial banner, WhatsApp banner; admin-only writes" },
    "/feature_boxes/{boxId}": { "schema": { "$ref": "#/entities/FeatureBox" }, "description": "Home grid boxes; admin-only writes" },
    "/home_top_links/{linkId}": { "schema": { "$ref": "#/entities/HomeTopLink" }, "description": "Home quick bar links; admin-only writes" },
    "/complaint_options/{optId}": { "schema": { "$ref": "#/entities/ComplaintOption" }, "description": "Complaint desk channels; admin-only writes" },
    "/financial_services/{serviceId}": { "schema": { "$ref": "#/entities/FinancialService" }, "description": "Teacher financial services; admin-only writes" },
    "/promo_banners/{bannerId}": { "schema": { "$ref": "#/entities/PromoBanner" }, "description": "Promotional home banners; admin-only writes" },
    "/news_articles/{newsId}": { "schema": { "$ref": "#/entities/NewsArticle" }, "description": "Admin-published education news; admin-only writes" },
    "/video_tutorials/{videoId}": { "schema": { "$ref": "#/entities/VideoTutorial" }, "description": "Video tutorials; admin-only writes" },
    "/download_resources/{resId}": { "schema": { "$ref": "#/entities/DownloadResource" }, "description": "PDF and form download items; admin-only writes" },
    "/youtube_feeds/{feedId}": { "schema": { "$ref": "#/entities/YouTubeFeed" }, "description": "YouTube RSS feeds; admin-only writes" },
    "/news_rss_feeds/{feedId}": { "schema": { "$ref": "#/entities/NewsRssFeed" }, "description": "News RSS feeds; admin-only writes" },
    "/salary_rules/{ruleId}": { "schema": { "$ref": "#/entities/SalaryRule" }, "description": "DA and HRA percentages; admin-only writes" },
    "/admin_audit_logs/{logId}": { "schema": { "$ref": "#/entities/AdminAuditLog" }, "description": "Append-only admin audit trail" },
    "/admin_users/{adminUid}": { "schema": { "$ref": "#/entities/AdminUser" }, "description": "Restricted admin profile directory" },
    "/ai_config/{configId}": { "schema": { "$ref": "#/entities/AiConfig" }, "description": "AI writer rate-limit & enablement config" },
    "/feedback/{feedbackId}": { "schema": { "$ref": "#/entities/FeedbackItem" }, "description": "Authenticated teacher feedback submissions" },
    "/audit_logs/{logId}": { "schema": { "$ref": "#/entities/ServerOnlyRecord" }, "description": "Server-only Cloud Functions audit logs" },
    "/ai_usage/{deviceId}": { "schema": { "$ref": "#/entities/ServerOnlyRecord" }, "description": "Server-only daily AI usage counters" },
    "/notification_history/{notifId}": { "schema": { "$ref": "#/entities/ServerOnlyRecord" }, "description": "Server-only FCM dispatch logs" },
    "/notice_categories/{catId}": { "schema": { "$ref": "#/entities/LegacyPublicConfig" }, "description": "Legacy notice categories" },
    "/public_config/{docId}": { "schema": { "$ref": "#/entities/LegacyPublicConfig" }, "description": "Legacy public configuration" },
    "/app_versions/{docId}": { "schema": { "$ref": "#/entities/LegacyPublicConfig" }, "description": "Legacy app version metadata" },
