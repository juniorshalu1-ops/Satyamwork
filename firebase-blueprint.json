{
  "entities": {
    "Notice": {
      "title": "Notice",
      "description": "Departmental notice or circular published by the admin. Timestamps must be submitted with FieldValue.serverTimestamp().",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Notice headline" },
        "summary": { "type": "string", "description": "Brief summary of the notice" },
        "category": { "type": "string", "description": "Notice category" },
        "issueDate": { "type": "string", "description": "Formatted issue date string" },
        "department": { "type": "string", "description": "Issuing department" },
        "orderNumber": { "type": "string", "description": "Official order/letter number" },
        "officialUrl": { "type": "string", "description": "Official portal URL" },
        "pdfUrl": { "type": "string", "description": "Hosted R2 or external PDF URL" },
        "imageUrl": { "type": "string", "description": "Hosted R2 or external preview image URL" },
        "isFeatured": { "type": "boolean", "description": "Pinned to featured list" },
        "isPublished": { "type": "boolean", "description": "Publication state" },
        "publishedBy": { "type": "string", "description": "Publisher UID (optional Cloud Function field)" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (Cloud Function)" }
      },
      "required": ["title", "summary", "category", "issueDate", "isPublished"]
    },
    "HolidayCalendar": {
      "title": "HolidayCalendar",
      "description": "Official Bihar school holiday entry. Timestamps use FieldValue.serverTimestamp().",
