        "dateStr": { "type": "string" },
        "dayOfWeek": { "type": "string" },
        "month": { "type": "integer" },
        "type": { "type": "string" },
        "durationDays": { "type": "integer" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "dateStr", "month", "type", "durationDays", "timestamp"]
    },
